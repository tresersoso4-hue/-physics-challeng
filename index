<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>VESTIGE — The Science of Protection</title>
<style>
*{box-sizing:border-box}html,body{margin:0;background:#02050a;color:#eef7ff;font-family:Inter,Segoe UI,Arial,sans-serif}button{font:inherit;color:inherit;cursor:pointer}
body{min-height:100vh}.page{min-height:100vh;background:#02050a}.screen{display:none;min-height:100vh}.screen.on{display:block}
.refHome{position:relative;min-height:100vh;overflow:hidden;background:#02050a}
.refHome>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:saturate(.96) contrast(1.05)}
.refHome:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.08),transparent 40%,rgba(0,0,0,.06));pointer-events:none}
.hit{position:absolute;z-index:3;background:transparent;border:0}
.playHit{left:3.4%;top:35%;width:24%;height:10%}.aboutHit{left:3%;top:46%;width:10%;height:7%}.authorHit{left:14%;top:46%;width:12%;height:7%}
.cardHit{bottom:7.5%;height:32%;width:14%}.c1{left:1.5%}.c2{left:18.3%}.c3{left:35%}.c4{left:51.8%}.c5{left:68.5%}.c6{left:85.2%}
.topHit{right:1%;top:1%;width:6%;height:8%}
.toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);z-index:50;background:rgba(4,10,16,.94);border:1px solid #9edbff;padding:11px 18px;font-size:12px;box-shadow:0 0 25px rgba(80,180,255,.2);display:none}
.panel{min-height:100vh;padding:28px 4%;background:radial-gradient(circle at 50% 30%,rgba(44,100,150,.13),transparent 35%),#03070c}
.nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}.brand{letter-spacing:5px;font-weight:700}.back{background:rgba(7,14,22,.75);border:1px solid #3b566d;padding:10px 18px}
.title{font-size:clamp(34px,5vw,68px);letter-spacing:-2px;margin:5px 0 8px}.muted{color:#8295a8}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{border:1px solid rgba(160,205,255,.25);background:linear-gradient(145deg,rgba(12,22,32,.9),rgba(2,7,12,.96));padding:24px;min-height:230px;position:relative;overflow:hidden}.card h3{margin:10px 0;font-size:22px}.card p{color:#899bad;font-size:13px;line-height:1.6}.go{position:absolute;bottom:20px;left:24px;right:24px;background:rgba(70,150,220,.08);border:1px solid #3f627b;padding:10px}
.heroPanel{display:grid;grid-template-columns:1fr 1fr;gap:18px;max-width:1250px;margin:auto}.heroBox{border:1px solid #315067;background:rgba(5,11,17,.82);padding:26px}.armorSvg{width:min(100%,470px);display:block;margin:auto;filter:drop-shadow(0 25px 35px #000)}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px}.stat{border:1px solid #20384b;padding:15px}.stat b{display:block;font-size:22px;margin-top:5px}
.quizQ{max-width:900px;margin:auto;border:1px solid #3c5a70;background:rgba(7,13,20,.88);padding:28px}.opts{display:grid;grid-template-columns:1fr 1fr;gap:10px}.opt{background:#071019;border:1px solid #294459;padding:14px;text-align:left}.opt:hover{border-color:#a6ddff}
.range{min-height:100vh;padding:22px;background:linear-gradient(#1b2b38,#0d1820 52%,#05090d 52%);position:relative;overflow:hidden}.range:before{content:"";position:absolute;left:0;right:0;top:31%;height:22%;background:linear-gradient(135deg,transparent 28%,#314655 29%,#314655 40%,transparent 41%),linear-gradient(45deg,transparent 35%,#263d4c 36%,#263d4c 47%,transparent 48%);opacity:.65}
.rangeTop{position:relative;display:flex;justify-content:space-between;z-index:2}.rangeHud{position:absolute;z-index:3;top:85px;left:22px;width:230px;border:1px solid #7199b3;background:rgba(3,9,14,.82);padding:15px}.rangeRight{left:auto;right:22px}.zoneBtns{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:12px}.zoneBtns button{background:#07111a;border:1px solid #35566d;padding:9px;font-size:11px}
.mannequin{position:absolute;z-index:2;left:50%;top:31%;transform:translateX(-50%);width:180px;height:370px}.head{width:62px;height:62px;border-radius:50%;margin:auto;background:#11181e;border:1px solid #627887}.torso{width:142px;height:195px;margin:4px auto;background:#172027;clip-path:polygon(18% 0,82% 0,100% 100%,0 100%);position:relative;border:1px solid #536a79}.vest{position:absolute;inset:20px 17px 35px;border:2px solid #91b9d1;background:repeating-linear-gradient(0deg,#17232c 0 12px,#0d151c 12px 15px);clip-path:polygon(8% 0,92% 0,100% 100%,0 100%)}.label{text-align:center;margin-top:12px;font-size:10px;letter-spacing:2px;color:#b9d3e6}
.bar{height:4px;background:#1a2935;margin-top:7px}.bar i{display:block;height:100%;background:#a6ddff}
@media(max-width:850px){.grid,.heroPanel{grid-template-columns:1fr}.opts{grid-template-columns:1fr}.refHome>img{object-position:center top}.cardHit{display:none}.playHit{left:7%;top:34%;width:42%;height:10%}}

/* INTERACTIVE HERO ARMOR */
.armorFocus{
 position:absolute;z-index:4;
 left:36.4%;top:6.2%;width:29%;height:48.5%;
 display:flex;align-items:center;justify-content:center;
 perspective:1100px;pointer-events:auto;
 transform-style:preserve-3d;
 transition:transform .12s ease-out;
 cursor:grab;
}
.armorFocus:active{cursor:grabbing}
.armorFocus img{
 width:100%;height:100%;object-fit:cover;object-position:center;
 transform-origin:center center;
 transform:translateZ(0) rotateY(var(--ry,0deg)) rotateX(var(--rx,0deg)) scale(var(--zoom,1));
 transition:transform .12s ease-out;
 -webkit-mask-image:radial-gradient(ellipse 52% 58% at 50% 49%,#000 45%,rgba(0,0,0,.92) 64%,transparent 84%);
 mask-image:radial-gradient(ellipse 52% 58% at 50% 49%,#000 45%,rgba(0,0,0,.92) 64%,transparent 84%);
 filter:drop-shadow(0 22px 24px rgba(0,0,0,.72)) brightness(1.05) contrast(1.06);
}
.armorGlow{
 position:absolute;inset:8% 12%;
 border-radius:50%;
 background:radial-gradient(ellipse,rgba(137,211,255,.16),transparent 65%);
 pointer-events:none;mix-blend-mode:screen;
 animation:armorPulse 3s ease-in-out infinite;
}
.armorHint{
 position:absolute;bottom:-4px;left:50%;transform:translateX(-50%);
 white-space:nowrap;font-size:8px;letter-spacing:2px;color:rgba(210,235,255,.62);
 opacity:0;transition:.3s;background:rgba(0,5,9,.55);padding:5px 8px;border:1px solid rgba(160,205,255,.16)
}
.armorFocus:hover .armorHint{opacity:1}
@keyframes armorPulse{50%{opacity:.55;transform:scale(1.08)}}
@media(max-width:850px){
 .armorFocus{left:25%;top:9%;width:50%;height:39%}
 .armorHint{display:none}
}

</style></head>
<body><div class="page">

<section id="home" class="screen on">
<div class="refHome">
<img src="data:image/jpeg;base64," alt="VESTIGE reference">

<div id="armorFocus" class="armorFocus" aria-label="Interactive armor">
  <img src="data:image/jpeg;base64," alt="">
  <div class="armorGlow"></div>
  <div class="armorHint">DRAG · ROTATE &nbsp;&nbsp; SCROLL · ZOOM</div>
</div>
<button class="hit playHit" onclick="openScreen('hub')"></button>
<button class="hit aboutHit" onclick="openScreen('about')"></button>
<button class="hit authorHit" onclick="openScreen('author')"></button>
<button class="hit cardHit c1" onclick="openScreen('lab')"></button>
<button class="hit cardHit c2" onclick="openScreen('assembly')"></button>
<button class="hit cardHit c3" onclick="openScreen('range')"></button>
<button class="hit cardHit c4" onclick="openScreen('materials')"></button>
<button class="hit cardHit c5" onclick="openScreen('physics')"></button>
<button class="hit cardHit c6" onclick="openScreen('quiz')"></button>
</div></section>

<section id="hub" class="screen"><div class="panel"><div class="nav"><div class="brand">VESTIGE</div><button class="back" onclick="openScreen('home')">← HOME</button></div><div class="muted">THE SCIENCE OF PROTECTION · GAME MODES</div><h1 class="title">CHOOSE YOUR CHALLENGE</h1><div class="grid">
<div class="card"><small>01</small><h3>ARMOR LAB</h3><p>Interactive inspection of the armor concept and its zones.</p><button class="go" onclick="openScreen('lab')">ENTER LAB →</button></div>
<div class="card"><small>02</small><h3>ASSEMBLY</h3><p>Randomized layer-order puzzle with a different layout each round.</p><button class="go" onclick="openScreen('assembly')">START →</button></div>
<div class="card"><small>03</small><h3>CHALLENGES</h3><p>Safe mannequin-based integrity simulation.</p><button class="go" onclick="openScreen('range')">ENTER →</button></div>
<div class="card"><small>04</small><h3>MATERIALS</h3><p>Explore the conceptual roles of different material categories.</p><button class="go" onclick="openScreen('materials')">OPEN →</button></div>
<div class="card"><small>05</small><h3>PHYSICS ENGINE</h3><p>Experiment with the educational kinetic-energy model.</p><button class="go" onclick="openScreen('physics')">RUN →</button></div>
<div class="card"><small>06</small><h3>QUIZ</h3><p>Randomized knowledge challenge.</p><button class="go" onclick="openScreen('quiz')">START →</button></div>
</div></div></section>

<section id="lab" class="screen"><div class="panel"><div class="nav"><div><div class="muted">01 // ARMOR LAB</div><h1 class="title">ARMOR OVERVIEW</h1></div><button class="back" onclick="openScreen('home')">← BACK</button></div>
<div class="heroPanel"><div class="heroBox"><svg class="armorSvg" viewBox="0 0 420 500"><defs><linearGradient id="g" x1="0" x2="1"><stop stop-color="#101820"/><stop offset=".5" stop-color="#33434e"/><stop offset="1" stop-color="#080d12"/></linearGradient></defs><path d="M92 75Q110 35 155 28H265Q310 35 328 75L360 112 333 190 315 470Q210 495 105 470L87 190 60 112Z" fill="url(#g)" stroke="#9bc7df" stroke-width="5"/><path d="M130 58Q160 105 210 105T290 58" fill="none" stroke="#718a9a" stroke-width="12"/><path d="M85 180H335M92 220H328M96 260H324M100 300H320M103 340H317M105 380H315M107 420H313" stroke="#506572" stroke-width="4"/><rect x="122" y="235" width="176" height="112" rx="8" fill="#0b1218" stroke="#7ea7bd" stroke-width="3"/></svg></div>
<div class="heroBox"><h2>ARMOR OVERVIEW</h2><p class="muted">Tap a category to inspect the conceptual system.</p><div class="stats"><div class="stat">PROTECTION<b>98%</b></div><div class="stat">WEIGHT<b>6.8 kg</b></div><div class="stat">DURABILITY<b>95%</b></div><div class="stat">FLEXIBILITY<b>92%</b></div></div><p class="muted">This interface is an educational game model, not a real performance specification.</p></div></div></div></section>

<section id="assembly" class="screen"><div class="panel"><div class="nav"><div><div class="muted">02 // ASSEMBLY</div><h1 class="title">RECONSTRUCT</h1></div><button class="back" onclick="openScreen('home')">← BACK</button></div><div class="quizQ" style="text-align:center"><p class="muted">Arrange the conceptual sequence from OUTER to INNER.</p><div id="puzzle" class="grid" style="grid-template-columns:repeat(3,1fr);max-width:600px;margin:20px auto"></div><div id="pm" class="muted"></div><button class="go" style="position:static;margin-top:15px" onclick="newPuzzle()">NEW ROUND</button></div></div></section>

<section id="materials" class="screen"><div class="panel"><div class="nav"><div><div class="muted">04 // MATERIALS</div><h1 class="title">MATERIAL INTELLIGENCE</h1></div><button class="back" onclick="openScreen('home')">← BACK</button></div><div class="grid"><div class="card"><h3>COMPOSITE</h3><p>Multiple constituents represented as a combined material category.</p></div><div class="card"><h3>CERAMIC</h3><p>A hard material category in the educational model.</p></div><div class="card"><h3>METAL</h3><p>A structural engineering material category.</p></div><div class="card"><h3>POLYMER</h3><p>A flexible material category used to explore comfort and structure.</p></div></div></div></section>

<section id="physics" class="screen"><div class="panel"><div class="nav"><div><div class="muted">05 // PHYSICS</div><h1 class="title">ENERGY ENGINE</h1></div><button class="back" onclick="openScreen('home')">← BACK</button></div><div class="heroPanel"><div class="heroBox"><div style="font:42px Georgia;text-align:center;padding:30px">E = ½mv²</div><label>Mass: <b id="mv">4 kg</b></label><input id="m" type="range" min="1" max="20" value="4" style="width:100%"><br><br><label>Velocity: <b id="vv">20 m/s</b></label><input id="v" type="range" min="1" max="80" value="20" style="width:100%"></div><div class="heroBox"><div class="muted">LIVE OUTPUT</div><div style="font-size:60px;text-align:center;margin:50px 0" id="en">800 J</div><div class="muted">Educational model only.</div></div></div></div></section>

<section id="quiz" class="screen"><div class="panel"><div class="nav"><div><div class="muted">06 // QUIZ</div><h1 class="title">KNOWLEDGE CHECK</h1></div><button class="back" onclick="openScreen('home')">← BACK</button></div><div class="quizQ"><div id="qc" class="muted"></div><h2 id="qt"></h2><div id="qo" class="opts"></div><div id="qf" class="muted"></div></div></div></section>

<section id="range" class="screen"><div class="range"><div class="rangeTop"><div class="brand">VESTIGE · ARMOR TEST RANGE</div><button class="back" onclick="openScreen('home')">← BACK</button></div>
<div class="rangeHud"><b>◎ TEST ZONE</b><div class="muted" style="font-size:11px;margin-top:7px">Abstract mannequin simulation</div><div class="zoneBtns"><button onclick="zone('CENTER')">CENTER</button><button onclick="zone('LEFT')">LEFT</button><button onclick="zone('RIGHT')">RIGHT</button><button onclick="zone('UPPER')">UPPER</button></div><div id="rs" class="muted" style="margin-top:12px">SYSTEM READY</div></div>
<div class="rangeHud rangeRight"><b>▣ TARGET INFO</b><div style="margin-top:16px">ARMOR INTEGRITY <b id="ri">100%</b></div><div class="bar"><i id="rb" style="width:100%"></i></div><p class="muted" style="font-size:11px">Game indicator only.</p></div>
<div class="mannequin"><div class="head"></div><div class="torso"><div class="vest"></div></div><div class="label">TRAINING MANNEQUIN</div></div></div></section>

<section id="about" class="screen"><div class="panel"><div class="nav"><h1 class="title">ABOUT</h1><button class="back" onclick="openScreen('home')">← HOME</button></div><div class="card"><h3>THE SCIENCE OF PROTECTION</h3><p>VESTIGE is an interactive educational game about armor structure, materials and physics.</p><p class="muted">The supplied reference is used as the visual direction for the main screen.</p></div></div></section>
<section id="author" class="screen"><div class="panel"><div class="nav"><h1 class="title">AUTHOR</h1><button class="back" onclick="openScreen('home')">← HOME</button></div><div class="card"><h3>МАХКАМОВ АСАДБЕК</h3><p class="muted">Ю-2.26</p></div></div></section>
</div><div id="toast" class="toast"></div>

<script>
const screens=[...document.querySelectorAll('.screen')];
function openScreen(id){screens.forEach(s=>s.classList.toggle('on',s.id===id));window.scrollTo(0,0);if(id==='quiz')startQuiz();if(id==='assembly')newPuzzle()}
function toast(t){let x=document.getElementById('toast');x.textContent=t;x.style.display='block';setTimeout(()=>x.style.display='none',1500)}
let arr=['OUTER','STRUCTURE','CORE','INNER','ENERGY','MOTION','MASS','FORCE','LOAD'],sel=-1;
function newPuzzle(){arr=[...arr].sort(()=>Math.random()-.5);sel=-1;renderPuzzle()}
function renderPuzzle(){let p=document.getElementById('puzzle');p.innerHTML='';arr.forEach((x,i)=>{let b=document.createElement('button');b.className='card';b.style.minHeight='95px';b.textContent=x;b.onclick=()=>{if(sel<0){sel=i;b.style.borderColor='#bde8ff'}else if(sel!==i){[arr[sel],arr[i]]=[arr[i],arr[sel]];sel=-1;renderPuzzle();if(arr.join('|')==='OUTER|STRUCTURE|CORE|INNER|ENERGY|MOTION|MASS|FORCE|LOAD')document.getElementById('pm').textContent='SEQUENCE COMPLETE · +150 XP'}};p.appendChild(b)})}
const bank=[
['What does E = ½mv² describe?',['Kinetic energy','Temperature','Pressure','Density'],0],
['Which variable is squared?',['Mass','Velocity','Time','Area'],1],
['Why use multiple conceptual layers?',['Different layers can have different roles','It always weighs less','It removes all forces','It needs no structure'],0],
['A composite is…',['A combination of constituents','Only a liquid','Only pure metal','A constant'],0],
['What is ergonomics about?',['System-user interaction','Only color','Only price','Only temperature'],0],
['If velocity doubles, kinetic energy becomes…',['2×','4×','½×','Unchanged'],1],
['Which unit measures energy?',['Joule','Kilogram','Meter','Second'],0],
['What is a game simulation?',['A simplified model for exploration','A field certificate','A guarantee','A replacement for standards'],0],
['What does modular mean?',['Conceptual components can be examined separately','One piece only','No structure','Always flexible'],0],
['Which mode changes mass and velocity?',['Physics','About','Author','Profile'],0],
['Which mode explores material categories?',['Materials','Quiz','About','Home'],0],
['What happens to E as velocity approaches zero?',['It approaches zero','It becomes infinite','It doubles','It stays fixed'],0]
];
let qs=[],qi=0;
function startQuiz(){qs=[...bank].sort(()=>Math.random()-.5).slice(0,8);qi=0;renderQ()}
function renderQ(){let q=qs[qi];document.getElementById('qc').textContent='QUESTION '+(qi+1)+' / '+qs.length;document.getElementById('qt').textContent=q[0];let o=document.getElementById('qo');o.innerHTML='';q[1].forEach((x,i)=>{let b=document.createElement('button');b.className='opt';b.textContent=x;b.onclick=()=>{o.querySelectorAll('button').forEach(z=>z.disabled=true);document.getElementById('qf').textContent=i===q[2]?'✓ CORRECT':'✕ NOT QUITE';setTimeout(()=>{qi++;if(qi<qs.length)renderQ();else{document.getElementById('qt').textContent='ROUND COMPLETE';o.innerHTML='';document.getElementById('qf').textContent='Start the quiz again for a new randomized round.'}},500)};o.appendChild(b)})}
document.getElementById('m').oninput=calc;document.getElementById('v').oninput=calc;function calc(){let m=+document.getElementById('m').value,v=+document.getElementById('v').value,e=.5*m*v*v;document.getElementById('mv').textContent=m+' kg';document.getElementById('vv').textContent=v+' m/s';document.getElementById('en').textContent=Math.round(e).toLocaleString()+' J'}calc();
let integrity=100;function zone(z){let d=4+Math.floor(Math.random()*13);integrity=Math.max(0,integrity-d);document.getElementById('ri').textContent=integrity+'%';document.getElementById('rb').style.width=integrity+'%';document.getElementById('rs').textContent=z+' ZONE ANALYZED · ABSTRACT INTEGRITY -'+d+'%'}
newPuzzle();

// Interactive hero armor: pointer drag rotates the armor; wheel/pinch changes zoom.
(function(){
 const el=document.getElementById('armorFocus');
 if(!el)return;
 let dragging=false,lastX=0,lastY=0,rx=0,ry=0,zoom=1;
 const clamp=(n,a,b)=>Math.max(a,Math.min(b,n));
 function render(){
   el.style.setProperty('--rx',rx.toFixed(2)+'deg');
   el.style.setProperty('--ry',ry.toFixed(2)+'deg');
   el.style.setProperty('--zoom',zoom.toFixed(3));
 }
 el.addEventListener('pointerdown',e=>{
   dragging=true;lastX=e.clientX;lastY=e.clientY;el.setPointerCapture?.(e.pointerId);
 });
 el.addEventListener('pointermove',e=>{
   if(!dragging)return;
   ry=clamp(ry+(e.clientX-lastX)*0.34,-22,22);
   rx=clamp(rx-(e.clientY-lastY)*0.18,-10,10);
   lastX=e.clientX;lastY=e.clientY;render();
 });
 el.addEventListener('pointerup',()=>dragging=false);
 el.addEventListener('pointercancel',()=>dragging=false);
 el.addEventListener('wheel',e=>{
   e.preventDefault();
   zoom=clamp(zoom+(e.deltaY<0?.08:-.08),.86,1.42);render();
 },{passive:false});
 let pinchStart=0,pinchZoom=1;
 el.addEventListener('touchstart',e=>{
   if(e.touches.length===2){
     pinchStart=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
     pinchZoom=zoom;
   }
 },{passive:true});
 el.addEventListener('touchmove',e=>{
   if(e.touches.length===2){
     const d=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
     zoom=clamp(pinchZoom*d/pinchStart,.86,1.42);render();
   }
 },{passive:true});
 // Gentle idle motion when the player is not interacting.
 let t=0;
 function idle(){
   if(!dragging){
     t+=.012;
     el.style.setProperty('--ry', (ry+Math.sin(t)*2.8).toFixed(2)+'deg');
     el.style.setProperty('--rx', (rx+Math.cos(t*.8)*1.2).toFixed(2)+'deg');
   }
   requestAnimationFrame(idle);
 }
 render();idle();
})();

</script></body></html>
